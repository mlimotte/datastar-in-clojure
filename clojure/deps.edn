{:paths ["src" "resources"]
 :deps  {org.clojure/clojure      {:mvn/version "1.12.1"}
         http-kit/http-kit        {:mvn/version "2.9.0-beta4"}
         metosin/reitit-ring      {:mvn/version "0.11.0"}
         ring/ring-core           {:mvn/version "1.15.5"}
         hiccup/hiccup            {:mvn/version "2.0.0"}
         cheshire/cheshire        {:mvn/version "6.2.0"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]}
  ;; the exercise track (generated by lk exercises): clojure -M:ex -d ex
  :ex   {:extra-paths ["ex"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]}
  ;; REPL on the exercise track: clj -A:ex-repl  (-A:ex would run :ex's main-opts, the test runner)
  :ex-repl {:extra-paths ["ex"]}}}
